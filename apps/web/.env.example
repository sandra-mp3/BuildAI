# BuildAI web — environment variables
# Copy to .env.local. All Firebase values come from your Firebase project settings.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Base URL of the NestJS API (apps/api). Most of BuildAI works fine
# without this actually running (see the demo mode note below), but the
# Billing page always calls this real API directly — payments are the one
# feature that deliberately never runs against the in-browser demo store,
# since only a real server should ever be trusted to talk to Stripe/M-Pesa.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Stripe publishable key — safe to expose in client-side code by design.
# Not currently used by the redirect-based Checkout flow, but reserved in
# case the app later embeds Stripe's own card element directly.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# If the Firebase variables above are left empty, the app runs in demo mode:
# auth, AI generation, and chat are simulated in-memory so the product is
# fully explorable without any credentials. Billing still shows real
# pricing in this mode, but starting checkout will explain that payments
# aren't connected rather than pretending to charge anyone.
