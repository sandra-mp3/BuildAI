# BuildAI API — environment variables
# Copy to .env

PORT=4000
WEB_ORIGIN=http://localhost:3000

# PostgreSQL. Works with a single connection string (Neon, Railway,
# Render, local Docker Compose) — just set DATABASE_URL and DIRECT_URL to
# the same value in that case. If using Supabase's connection pooler
# (recommended for serverless/production), set DATABASE_URL to the pooled
# "transaction mode" URL and DIRECT_URL to the direct "session mode" URL —
# see the comment on the `datasource` block in prisma/schema.prisma for why
# migrations specifically need the direct, unpooled connection.
DATABASE_URL=postgresql://buildai:buildai@localhost:5432/buildai
DIRECT_URL=postgresql://buildai:buildai@localhost:5432/buildai

# Firebase Admin SDK — generate a service account key in
# Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Groq — used for structured application generation, chat editing, and
# error diagnosis. Get a key at https://console.groq.com/keys
# Groq's exact model lineup changes over time; GROQ_MODEL lets you point
# at a different one without touching code if the default is retired.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Stripe — card payments for subscriptions (see modules/billing/stripe.service.ts).
# Get these from the Stripe Dashboard > Developers > API keys / Webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# M-Pesa Daraja API — mobile money payments for Kenyan users
# (see modules/billing/mpesa.service.ts). Get these from
# https://developer.safaricom.co.ke after creating an app.
# MPESA_ENV controls which Safaricom environment is used: "sandbox" (fake
# money, safe for testing) or "production" (real money). Defaults to
# sandbox if unset, on purpose — see mpesa.service.ts for why.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Must be a real, internet-reachable URL — Safaricom's servers call this
# directly, so it can't be localhost. Use a tunneling tool (e.g. ngrok)
# during local development.
MPESA_CALLBACK_URL=https://your-deployed-api.example.com/billing/webhooks/mpesa
